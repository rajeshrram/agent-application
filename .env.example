# --- LLM (Nebius Token Factory / Nebius AI Studio, OpenAI-compatible API) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- Mode switches: keep true until you wire the real integration.
# Everything runs end-to-end with all three set to true and no API keys at all. ---
JIRA_MOCK=true
SLACK_MOCK=true
GMAIL_MOCK=true

# --- JIRA ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# --- Gmail ---
GMAIL_MANAGER_ADDRESS=manager@example.com
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# --- App DB / checkpointer ---
APP_DB_PATH=data/app.db
CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# --- Schedule (24h, local time) ---
PING_HOUR=9
PING_MINUTE=0
CUTOFF_HOUR=16
CUTOFF_MINUTE=0

# --- Human-in-the-loop ---
# If true, the daily_collation graph pauses for manager approval before the
# summary email is sent (resume via scripts/approve_summary.py).
REQUIRE_SUMMARY_APPROVAL=false
